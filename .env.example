# ART — Environment Variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed.

# ── LLM Provider ────────────────────────────────────────────
# Choose one: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# ── API Keys ─────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# ── GitHub OAuth App (recommended) ───────────────────────────
# Register an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/api/auth/github/callback
# (Use http://localhost:8000/api/auth/github/callback for local dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub Ingestion (fallback) ───────────────────────────────
# Personal access token — only needed if not using OAuth above.
# Create one at: https://github.com/settings/tokens (read:user, repo scopes)
GITHUB_TOKEN=

# Default GitHub username for `ingest github` (optional — can type it in chat)
GITHUB_USERNAME=

# ── Database ─────────────────────────────────────────────────
# Production is Supabase Postgres — develop against Postgres too.
# `docker compose up -d postgres` starts a local pgvector Postgres on 5433:
# DATABASE_URL=postgresql://art:art@localhost:5433/art
#
# Production (Supabase). Use the POOLER string (port 6543), not the direct
# connection (5432), for a hosted deploy:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Left unset, the app falls back to local SQLite (~/.art/art.db). That keeps
# cli.py and the no-Docker path working, but it is a fallback, not the target.
# DATABASE_URL=

# Postgres DSN for the test suite's Postgres leg. Deliberately SEPARATE from
# DATABASE_URL: the suite creates and drops schemas, and DATABASE_URL may point
# at production Supabase. Never set the two to the same value.
# ART_TEST_DATABASE_URL=postgresql://art:art@localhost:5433/art

# Docker: override the local data directory (default: ~/.art)
# ART_DATA_DIR=/data

# ── Supabase Auth (Phase 2 — required for cloud multi-user) ──
# When these are set, ALL authentication goes through Supabase (email + password)
# and no password is stored locally. When absent, the app uses an offline local
# fallback for dev/tests only. Password recovery requires Supabase.
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=eyJ...              # safe to expose to the client
# SUPABASE_SERVICE_ROLE_KEY=eyJ...      # backend only — never expose to clients
# SUPABASE_JWT_SECRET=                  # Supabase → Settings → API → JWT Secret

# Public origin of the app, used to build the password-reset link's redirect
# target. Defaults to the incoming request's origin if unset (fine for local dev).
# In Supabase → Authentication → URL Configuration, add <APP_BASE_URL>/reset-password
# to the allowed Redirect URLs.
# APP_BASE_URL=https://web-production-2ead7.up.railway.app

# ── Web API ───────────────────────────────────────────────────
# Required for secure session cookies in the FastAPI web server.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Set to any non-empty value to enable CORS for local Vite dev server (:5173)
# DEV_MODE=1

# ── Rate limiting (production) ────────────────────────────────
# Per-user daily cap on AI calls (chat send, tailor). Default 20.
# AI_DAILY_LIMIT=20

# Bright Data LinkedIn scrapes are billed per call, so they get a much tighter
# separate cap. Default 2. Resets at midnight UTC.
# LINKEDIN_DAILY_LIMIT=2

# This address is exempt from every rate limit above.
# OWNER_EMAIL=

# ── LinkedIn ingestion via Bright Data (optional) ─────────────
# Platform-wide key. When unset, LinkedIn auto-import is disabled and the app
# falls back to the LinkedIn PDF upload path.
# BRIGHTDATA_API_KEY=
# Bright Data "People Profiles" dataset id (default shown).
# BRIGHTDATA_LINKEDIN_DATASET_ID=gd_l1viktl72bvl7bjuj0

# ── Per-role model overrides (optional) ──────────────────────
# Defaults shown. Uncomment and change to override.
# CHAT_MODEL=claude-haiku-4-5-20251001
# EXTRACT_MODEL=claude-haiku-4-5-20251001
# TAILOR_MODEL=claude-sonnet-4-6

# ── Observability: LangSmith tracing (optional; OFF by default) ──
# Wired for P3 RL. LangChain reads these env vars natively — tracing is enabled
# only when LANGCHAIN_TRACING_V2 is truthy AND a key is set. Covers extraction,
# chat, and tailoring uniformly (all on the LangChain path).
# PII WARNING: traces carry full resume + JD text. Do NOT enable in production
# until you self-host LangSmith (or set a data region) and scrub payloads.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=artie-dev

