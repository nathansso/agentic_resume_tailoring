---
import Base from "../layouts/Base.astro";
---

<Base
  title="Usage: ARTie"
  description="How to use ARTie once it is installed. Full documentation is coming soon."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Usage</h1>
    <p class="mt-4 text-lg text-muted-foreground">
      Full usage docs are coming soon. Until then, see INSTALL.md in the repository.
    </p>
    <p class="mt-8">
      <a
        href="https://github.com/nathansso/agentic_resume_tailoring/blob/main/INSTALL.md"
        rel="noopener"
        class="inline-flex items-center justify-center rounded-lg border border-border bg-card px-6 py-3 font-semibold transition-colors hover:bg-elevated"
      >
        Read INSTALL.md on GitHub
      </a>
    </p>
  </div>
</Base>
