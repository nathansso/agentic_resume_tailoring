---
// The role, then the resume before and after: two PDFs from the same real run, as images
// (issues #275, #337).
//
// before-after.json is written by scripts/build_site_demo.py. The posting card is the
// requirements the agent read from the sample posting. The highlighted boxes come from diffing
// the two PDFs' own text, bullet by bullet. The change groups are computed from the two
// versions ARTie stored and its own diff (diff_nodes); nothing here is hand-picked. Both pages
// are whole pages.
import data from "./before-after.json";

type Mark = { x: number; y: number; w: number; h: number };
type Source = { src: string; width: number; height: number };
type Side = { sources: Source[]; marks: Mark[] };
type Serves = { id: string; short: string }[];
type Group = { id: string; title: string; entries: any[] };

const posting = data.posting as {
  title: string;
  company: string;
  location: string;
  requirements: { id: string; short: string; text: string; type: string }[];
};
const groups = data.groups as Group[];
const shortTitle = (title: string) => title.split(",")[0];
const servesText = (serves?: Serves) => (serves ?? []).map((s) => s.short).join("; ");
const uniqueServes = (...lists: (Serves | undefined)[]) => {
  const seen = new Map<string, string>();
  for (const list of lists) for (const s of list ?? []) seen.set(s.id, s.short);
  return [...seen.values()].join("; ");
};

const sides = [
  {
    key: "before",
    title: "Before",
    sub: "Riley's usual one-page resume",
    detail:
      "The content of resume.md, laid out by ARTie from the knowledge graph. The three repo projects are left off and nothing is reworded. This is what Riley would send to every posting.",
    alt: "The student's usual one-page resume, laid out by ARTie from the sample knowledge graph. It leads with web development work. Lines that tailoring changes are highlighted in red. The changes are also listed as text below.",
    side: data.before as Side,
  },
  {
    key: "after",
    title: "After",
    sub: `Tailored to ${posting.company}`,
    detail:
      "Version 3 from the same run, after ARTie's checks: still one page, and built only from bullets in the graph.",
    alt: "The same student's resume after tailoring to the sample data science internship. Projects now come first, led by the A/B test project, and the page is still one page. Lines that tailoring changed or added are highlighted in green. The changes are also listed as text below.",
    side: data.after as Side,
  },
];
const changes = data.changes as { removed: string[]; added: string[] }[];
---

<div class="ba" data-ba>
  <section class="posting" aria-labelledby="posting-heading">
    <p class="posting-tag">Sample posting, written for this demo</p>
    <div class="posting-grid">
      <div>
        <h4 id="posting-heading" class="posting-title">{posting.title}</h4>
        <p class="posting-meta">{posting.company} <span aria-hidden="true">·</span> {posting.location}</p>
        <p class="posting-note">
          Neither the company nor the role is real. The list is what the agent read out of the posting's text.
        </p>
      </div>
      <div>
        <p class="posting-lead">What the posting asks for</p>
        <ul class="reqs">
          {posting.requirements.map((r) => (
            <li>
              <span>{r.short}</span>
              <span class="req-type">{r.type}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="grid gap-8 md:grid-cols-2 pages">
    {sides.map(({ key, title, sub, detail, alt, side }) => {
      const big = side.sources[0];
      return (
        <figure class="min-w-0">
          <figcaption class="mb-3">
            <span class="text-lg font-semibold">{title}</span>
            <span class="block text-sm font-medium">{sub}</span>
            <span class="block text-sm text-muted-foreground">{detail}</span>
          </figcaption>
          <div class="sheet">
            <img
              src={big.src}
              srcset={side.sources.map((s) => `${s.src} ${s.width}w`).join(", ")}
              sizes="(min-width: 768px) 480px, calc(100vw - 2rem)"
              width={big.width}
              height={big.height}
              alt={alt}
              loading="lazy"
              decoding="async"
            />
            <div class="marks" aria-hidden="true">
              {side.marks.map((m) => (
                <span
                  class={`mark mark-${key}`}
                  style={`left:${m.x * 100}%;top:${m.y * 100}%;width:${m.w * 100}%;height:${m.h * 100}%`}
                />
              ))}
            </div>
          </div>
          <p class="mt-2 text-sm">
            <a
              href={big.src}
              target="_blank"
              rel="noopener"
              class="text-accent underline underline-offset-4 hover:opacity-80"
            >
              Open the {title.toLowerCase()} page full size
            </a>
          </p>
        </figure>
      );
    })}
  </div>

  <label class="toggle" data-toggle hidden>
    <input type="checkbox" checked />
    Highlight the changed lines
  </label>

  <section class="what" aria-labelledby="what-heading">
    <h4 id="what-heading" class="what-title">What changed, and which requirement it serves</h4>
    <div class="groups">
      {groups.map((g) => (
        <article class={`group group-${g.id}`}>
          <h5 class="group-title">{g.title}</h5>
          <ul class="entries">
            {g.entries.map((e) => (
              <li class="entry">
                {g.id === "added" && (
                  <p>
                    <strong>{e.title}</strong> is now the {e.ordinal} project of {e.of}
                    {e.replaces ? `, in place of ${e.replaces}` : ""}. It was not on the usual page; it comes from a repo README in the graph.
                  </p>
                )}
                {g.id === "moved" && e.scope === "section" && (
                  <p>
                    <strong>{e.section}</strong> now sits above {e.above.join(" and ")}.
                  </p>
                )}
                {g.id === "moved" && e.scope === "bullet" && (
                  <p>
                    Under <strong>{shortTitle(e.title)}</strong>, bullet {e.from} moves to bullet {e.to}: <q>{e.text}</q>
                  </p>
                )}
                {g.id === "reworded" && (
                  <>
                    <p class="was"><span class="tag">Your wording</span> {e.before}</p>
                    <p class="now"><span class="tag">Now</span> {e.after}</p>
                  </>
                )}
                {g.id === "cut" && e.scope === "item" && (
                  <p>
                    <strong>{e.title}</strong>
                    {e.replaced_by ? ` is swapped for ${e.replaced_by}.` : ` comes off: the whole role, ${e.n_bullets} bullets. ${e.reason}`}
                  </p>
                )}
                {g.id === "cut" && e.scope === "bullet" && (
                  <p>
                    Under <strong>{shortTitle(e.title)}</strong>, <q>{e.text}</q> comes off. {e.reason}
                  </p>
                )}
                {g.id === "skills" && (
                  <>
                    <p>
                      {e.before_count} skills become {e.after_count}. The page now leads with {e.first.join(", ")}.
                    </p>
                    <p class="skills-line">
                      <span class="tag">Added</span> {e.added.map((a: { name: string }) => a.name).join(", ")}
                    </p>
                    <p class="skills-line">
                      <span class="tag">Taken off</span> {e.removed.join(", ")}
                    </p>
                  </>
                )}
                {g.id !== "skills" && g.id !== "cut" && (e.serves ?? []).length > 0 && (
                  <p class="serves">
                    <span class="serves-label">Serves</span> {servesText(e.serves)}
                  </p>
                )}
                {g.id === "skills" && (
                  <p class="serves">
                    <span class="serves-label">Serves</span>
                    {uniqueServes(...e.added.map((a: { serves: Serves }) => a.serves), ...e.led_by.map((a: { serves: Serves }) => a.serves))}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="what-note">
      The changes themselves are ARTie's own comparison of the two versions. Each requirement is matched to a change from the posting terms the plan named for that item. The reasons given for cuts were written for this demo.
    </p>
  </section>

  <details class="changes">
    <summary>Read every changed line as text</summary>
    <ul class="mt-4 space-y-4">
      {changes.map((c) => (
        <li class="rounded-lg border border-border bg-card p-4 text-sm">
          {c.removed.map((t) => (
            <p class="del"><span class="tag">Before</span> {t}</p>
          ))}
          {c.added.map((t) => (
            <p class="ins"><span class="tag">After</span> {t}</p>
          ))}
        </li>
      ))}
    </ul>
    <p class="mt-3 text-sm text-muted-foreground">
      These come from comparing the two PDFs' text bullet by bullet. A bullet moved to a new
      place shows once as removed and once as added.
    </p>
  </details>
</div>

<style>
  .posting {
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--card));
    padding: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .posting-tag {
    display: inline-block;
    margin: 0 0 0.9rem;
    border: 1px solid hsl(var(--accent));
    border-radius: 9999px;
    padding: 0.1rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: hsl(var(--accent));
  }
  .posting-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .posting {
      padding: 1.75rem;
    }
    .posting-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 2.5rem;
    }
  }
  .posting-title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .posting-meta {
    margin: 0.4rem 0 0;
    font-weight: 500;
  }
  .posting-note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }
  .posting-lead {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: hsl(var(--muted-foreground));
  }
  .reqs {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .reqs li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
    padding-bottom: 0.5rem;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .reqs li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .req-type {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground));
  }
  .sheet {
    position: relative;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: 0 6px 24px -10px rgb(0 0 0 / 0.25);
    line-height: 0;
  }
  .sheet img {
    display: block;
    width: 100%;
    height: auto;
  }
  .marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .mark {
    position: absolute;
    border-left: 3px solid;
    border-radius: 2px;
  }
  .mark-before {
    background: rgb(220 38 38 / 0.16);
    border-color: rgb(220 38 38 / 0.85);
  }
  .mark-after {
    background: rgb(16 150 90 / 0.18);
    border-color: rgb(16 150 90 / 0.9);
  }
  [data-ba].marks-off .marks {
    display: none;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .toggle input {
    accent-color: hsl(var(--accent));
  }
  .toggle[hidden] {
    display: none;
  }
  .what {
    margin-top: 2.5rem;
  }
  .what-title {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .groups {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
    }
    .group-reworded,
    .group-cut,
    .group-added {
      grid-column: 1 / -1;
    }
  }
  .group {
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: hsl(var(--card));
    padding: 1rem 1.1rem;
    min-width: 0;
  }
  .group-title {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .group-added .group-title {
    color: hsl(var(--success));
  }
  .group-cut .group-title {
    color: hsl(var(--destructive));
  }
  .group-moved .group-title,
  .group-reworded .group-title,
  .group-skills .group-title {
    color: hsl(var(--accent));
  }
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }
  .entry {
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .entry p {
    margin: 0 0 0.35rem;
  }
  .entry q {
    quotes: "\201c" "\201d";
    color: hsl(var(--muted-foreground));
  }
  .was {
    color: hsl(var(--muted-foreground));
  }
  .serves {
    color: hsl(var(--foreground));
  }
  .serves-label {
    display: inline-block;
    margin-right: 0.4rem;
    border-radius: 9999px;
    background: hsl(var(--accent) / 0.14);
    color: hsl(var(--accent));
    padding: 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .what-note {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }
  .changes {
    margin-top: 1.5rem;
  }
  .changes summary {
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    width: max-content;
    max-width: 100%;
  }
  .del,
  .ins {
    margin: 0 0 0.5rem;
    overflow-wrap: anywhere;
  }
  .del {
    color: hsl(var(--muted-foreground));
  }
  .tag {
    display: inline-block;
    margin-right: 0.4rem;
    border: 1px solid hsl(var(--border));
    border-radius: 9999px;
    padding: 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ins .tag,
  .now .tag {
    color: hsl(var(--success));
  }
  .del .tag {
    color: hsl(var(--destructive));
  }
  .skills-line {
    color: hsl(var(--muted-foreground));
  }
</style>

<script>
  const ba = document.querySelector<HTMLElement>("[data-ba]");
  const toggle = ba?.querySelector<HTMLElement>("[data-toggle]");
  const box = toggle?.querySelector<HTMLInputElement>("input");
  if (ba && toggle && box) {
    toggle.hidden = false;
    box.addEventListener("change", () => ba.classList.toggle("marks-off", !box.checked));
  }
</script>
