---
// Inline SVG icons (24x24 grid, stroke). The shapes follow the Lucide set (ISC
// license), copied here so the site needs no icon dependency. Decorative only:
// every use sits next to visible text, so they are aria-hidden.
interface Props {
  name:
    | "check"
    | "file-text"
    | "folder"
    | "briefcase"
    | "layers"
    | "target"
    | "list-checks"
    | "shield-check"
    | "printer"
    | "lock"
    | "chevron-down";
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;

const SHAPES: Record<Props["name"], string[]> = {
  check: ["M20 6 9 17l-5-5"],
  "file-text": [
    "M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z",
    "M14 2v4a2 2 0 0 0 2 2h4",
    "M16 13H8",
    "M16 17H8",
    "M10 9H8",
  ],
  folder: [
    "M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z",
  ],
  briefcase: [
    "M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16",
    "M4 7h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z",
  ],
  layers: ["M12 2 2 7l10 5 10-5-10-5Z", "m2 17 10 5 10-5", "m2 12 10 5 10-5"],
  target: [
    "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z",
    "M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z",
    "M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
  ],
  "list-checks": ["m3 17 2 2 4-4", "m3 7 2 2 4-4", "M13 6h8", "M13 12h8", "M13 18h8"],
  "shield-check": [
    "M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z",
    "m9 12 2 2 4-4",
  ],
  printer: [
    "M6 9V2h12v7",
    "M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2",
    "M6 14h12v8H6z",
  ],
  lock: ["M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z", "M7 11V7a5 5 0 0 1 10 0v4"],
  "chevron-down": ["m6 9 6 6 6-6"],
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {SHAPES[name].map((d) => <path d={d} />)}
</svg>
