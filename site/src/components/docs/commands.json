{
  "_comment": "Every command the install and usage pages show. tests/test_site_docs.py checks each line against its `source` file (INSTALL.md, plugin/README.md or integrations/codex/README.md), so a command here cannot drift from the docs. {SOURCE} and {URL} are expanded by commands.ts; bump the version in `vars` when INSTALL.md bumps the pin.",
  "vars": {
    "URL": "https://github.com/nathansso/agentic_resume_tailoring/releases/download/v0.2.0/art_mcp-0.2.0-py3-none-any.whl",
    "SOURCE": "art-mcp[ui] @ {URL}"
  },
  "blocks": {
    "claude-plugin": {
      "source": "INSTALL.md",
      "also": ["plugin/README.md"],
      "lines": [
        "/plugin marketplace add nathansso/agentic_resume_tailoring",
        "/plugin install artie@artie"
      ]
    },
    "codex-plugin": {
      "source": "INSTALL.md",
      "also": ["integrations/codex/README.md"],
      "lines": [
        "codex plugin marketplace add nathansso/agentic_resume_tailoring",
        "codex plugin add artie@artie"
      ]
    },
    "codex-hooks": {
      "source": "INSTALL.md",
      "also": ["integrations/codex/README.md"],
      "lines": [
        "uvx --python 3.12 --from \"{SOURCE}\" artie hooks codex --write"
      ]
    },
    "claude-mcp-add": {
      "source": "INSTALL.md",
      "lines": [
        "claude mcp add artie -- uvx --python 3.12 --from \"{SOURCE}\" artie mcp"
      ]
    },
    "codex-mcp-add": {
      "source": "integrations/codex/README.md",
      "lines": [
        "codex mcp add artie -- uvx --python 3.12 --from \"{SOURCE}\" artie mcp"
      ]
    },
    "list-tools": {
      "source": "INSTALL.md",
      "lines": [
        "uvx --python 3.12 --from \"{SOURCE}\" artie --list"
      ]
    },
    "art-ui": {
      "source": "INSTALL.md",
      "lines": [
        "uvx --python 3.12 --from \"{SOURCE}\" artie ui --job <job_id>"
      ]
    },
    "connect": {
      "source": "INSTALL.md",
      "lines": [
        "artie connect",
        "artie connect --private"
      ]
    },
    "connect-uvx": {
      "source": "INSTALL.md",
      "lines": [
        "uvx --python 3.12 --from \"{SOURCE}\" artie connect",
        "uvx --python 3.12 --from \"{SOURCE}\" artie connect --private"
      ]
    },
    "uv-install-unix": {
      "source": "INSTALL.md",
      "lines": [
        "curl -LsSf https://astral.sh/uv/install.sh | sh"
      ]
    },
    "uv-install-windows": {
      "source": "INSTALL.md",
      "lines": [
        "powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\""
      ]
    },
    "typesafe-key": {
      "source": "INSTALL.md",
      "lines": [
        "export TYPESAFE_API_KEY='...'"
      ]
    },
    "uv-tool-install": {
      "source": "INSTALL.md",
      "lines": [
        {
          "text": "uv tool install --python 3.12 \"{SOURCE}\"",
          "in_source": "uv tool install --python 3.12 \"art-mcp[ui] @ <the pinned URL>\""
        }
      ]
    },
    "uv-offline": {
      "source": "INSTALL.md",
      "lines": [
        "UV_OFFLINE=1"
      ]
    },
    "uv-cache-dir": {
      "source": "INSTALL.md",
      "lines": [
        "[Environment]::SetEnvironmentVariable(\"UV_CACHE_DIR\", \"C:\\uvc\", \"User\")"
      ]
    },
    "artie-setup": {
      "source": "plugin/README.md",
      "lines": [
        "/artie:setup [files]"
      ]
    }
  },
  "slash": [
    {
      "command": "/artie:setup [files]",
      "source": "plugin/README.md",
      "what": "Build your knowledge graph from your resume, LinkedIn export and project folders, and set your header."
    },
    {
      "command": "/artie:open [job]",
      "source": "plugin/README.md",
      "what": "Find a job and print the command that opens the local editor (artie ui)."
    },
    {
      "command": "/artie:history [job]",
      "source": "plugin/README.md",
      "what": "Find a job and list every version and what changed."
    }
  ],
  "inline": {
    "_comment": "Short commands and names the pages mention in running text. Each must appear verbatim in its source.",
    "artie jev status": "INSTALL.md",
    "artie github login": "INSTALL.md",
    "ART_JEV_MODE=off": "INSTALL.md",
    "TYPESAFE_API_KEY": "INSTALL.md",
    "ART_GITHUB_TOKEN": "INSTALL.md",
    "~/.art/art.db": "INSTALL.md",
    "/hooks": "INSTALL.md",
    "$artie-setup": "integrations/codex/README.md",
    "$artie-tailor": "integrations/codex/README.md",
    "~/.art/applications/<Company>_<Role>/": "plugin/README.md",
    "[embed]": "INSTALL.md",
    "[pdf]": "INSTALL.md",
    "[ui]": "INSTALL.md"
  }
}
